# Food Verse AI Backend Environment Configuration
# Copy this file to .env to configure optional live vision and language models

# Optional: Google Gemini API Key or generic vision AI Key
# If omitted or left empty, the application seamlessly runs in high-fidelity Demo Simulation Mode
AI_API_KEY=
GEMINI_API_KEY=

# Server configuration
PORT=5000
FLASK_ENV=development
DEBUG=True

# Maximum upload limits (in bytes: 16MB image, 40MB video)
MAX_CONTENT_LENGTH=41943040
